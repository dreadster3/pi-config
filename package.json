  "description": "Pi coding agent configuration — skills, extensions, prompts, and themes",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
