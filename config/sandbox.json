{
  "enabled": true,
  "enableAccessRequestTool": true,
  "permissionPromptTimeoutSeconds": 600,
  "allowBrowserProcess": true,
  "network": {
    "disabled": false,
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowAllUnixSockets": true,
    "allowedDomains": ["localhost", "127.0.0.1", "*.github.com"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/home", "/Users"],
    "allowRead": [
      ".",
      "~/.config",
      "~/.cargo",
      "~/go/bin",
      "~/.local",
      "~/.nix-profile",
      "~/.cache",
      "/nix/store"
    ],
    "allowWrite": [".", "/tmp", "~/.pi/"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
