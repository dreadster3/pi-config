{
  "enabled": true,
  "enableAccessRequestTool": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 600,
  "allowBrowserProcess": true,
  "network": {
    "disabled": false,
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/home", "/Users"],
    "allowRead": [
      ".",
      "~/.config",
      "~/.gitconfig",
      "~/.cargo",
      "~/go/bin",
      "~/.local",
      "~/.nix-profile",
      "~/.cache",
      "~/.ssh/id_ed25519_sign",
      "~/.ssh/*.pub",
      "~/Library",
      "/nix/store"
    ],
    "allowWrite": [".", "/tmp", "~/.pi/"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
