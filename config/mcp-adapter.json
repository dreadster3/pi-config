{
  "settings": {
    "jev": {
      "model": "jev-1.14"
    },
    "approveTools": "destructive"
  },
  "mcpServers": {
    "github": {
      "url": "https://<litellm-url>/github/mcp",
      "auth": "oauth",
      "headers": {
        "x-litellm-api-key": "Bearer ${LITELLM_API_KEY}"
      }
    },
    "searxng": {
      "url": "https://<litellm-url>/searxng/mcp",
      "auth": "bearer",
      "bearerToken": "${LITELLM_API_KEY}",
      "directTools": ["searxng-searxng_web_search", "searxng-web_url_read"]
    },
    "terraform": {
      "url": "https://<litellm-url>/terraform/mcp",
      "auth": "bearer",
      "bearerToken": "${LITELLM_API_KEY}"
    },
    "context7": {
      "url": "https://<litellm-url>/context7/mcp",
      "auth": "oauth",
      "headers": {
        "x-litellm-api-key": "Bearer ${LITELLM_API_KEY}"
      }
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--isolated"]
    },
    "nixos": {
      "command": "uvx",
      "args": ["mcp-nixos"]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "directTools": true
    },
    "excalidraw": {
      "url": "https://<litellm-url>/excalidraw/mcp",
      "auth": "bearer",
      "bearerToken": "${LITELLM_API_KEY}"
    }
  }
}
