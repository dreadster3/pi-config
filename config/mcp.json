{
  "mcpServers": {
    "github": {
      "url": "https://<litellm-url>/github/mcp",
      "exposeResources": true,
      "auth": "oauth",
      "headers": {
        "x-litellm-api-key": "Bearer ${LITELLM_API_KEY}"
      }
    },
    "searxng": {
      "url": "https://<litellm-url>/searxng/mcp",
      "exposeResources": true,
      "auth": "bearer",
      "bearerToken": "Bearer ${LITELLM_API_KEY}",
      "directTools": ["searxng-searxng_web_search", "searxng-web_url_read"]
    },
    "terraform": {
      "url": "https://<litellm-url>/terraform/mcp",
      "exposeResources": true,
      "auth": "bearer",
      "bearerToken": "Bearer ${LITELLM_API_KEY}"
    },
    "context7": {
      "url": "https://<litellm-url>/context7/mcp",
      "exposeResources": true,
      "auth": "oauth",
      "headers": {
        "x-litellm-api-key": "Bearer ${LITELLM_API_KEY}"
      }
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--isolated"],
      "exposeResources": true
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "exposeResources": true,
      "directTools": true
    }
  }
}
